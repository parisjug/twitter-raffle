# Test mock data - example files are kept for reference
# Actual generated mocks are now sanitized and safe to commit
# but gitignored by default to avoid unnecessary churn
src/test/resources/bluesky-mocks/*.json
!src/test/resources/bluesky-mocks/.gitkeep-example-*.json